#include<stdio.h>
#include<stdlib.h>

struct node{
    int coeff, exp;
    struct node *next;
};


struct node* create(int c, int e){
    struct node* newnode = (struct node*)malloc(sizeof(struct node));
    newnode->coeff = c;
    newnode->exp = e;
    newnode->next = NULL;
    return newnode;
}


struct node* add(struct node* p1, struct node* p2){
    struct node *result = NULL, *temp = NULL, *newnode;

    while(p1 != NULL && p2 != NULL){
        newnode = (struct node*)malloc(sizeof(struct node));

        if(p1->exp == p2->exp){
            newnode->coeff = p1->coeff + p2->coeff;
            newnode->exp = p1->exp;
            p1 = p1->next;
            p2 = p2->next;
        }
        else if(p1->exp > p2->exp){
            newnode->coeff = p1->coeff;
            newnode->exp = p1->exp;
            p1 = p1->next;
        }
        else{
            newnode->coeff = p2->coeff;
            newnode->exp = p2->exp;
            p2 = p2->next;
        }

        newnode->next = NULL;

        
        if(result == NULL){
            result = newnode;
            temp = newnode;
        }
        else{
            temp->next = newnode;
            temp = newnode;
        }
    }

  
    while(p1 != NULL){
        newnode = create(p1->coeff, p1->exp);

        if(result == NULL){
            result = newnode;
            temp = newnode;
        } else {
            temp->next = newnode;
            temp = newnode;
        }
        p1 = p1->next;
    }

    
    while(p2 != NULL){
        newnode = create(p2->coeff, p2->exp);

        if(result == NULL){
            result = newnode;
            temp = newnode;
        } else {
            temp->next = newnode;
            temp = newnode;
        }
        p2 = p2->next;
    }

    return result;
}


void display(struct node* head){
    while(head != NULL){
        printf("%dx^%d", head->coeff, head->exp);
        if(head->next != NULL)
            printf(" + ");
        head = head->next;
    }
    printf("\n");
}


int main(){
    struct node *p1=NULL, *p2=NULL, *result=NULL;

    // Polynomial 1: 3x^2 + 2x^1
    p1 = create(3,2);
    p1->next = create(2,1);

    // Polynomial 2: 5x^2 + 4x^0
    p2 = create(5,2);
    p2->next = create(4,0);

    printf("Polynomial 1: ");
    display(p1);

    printf("Polynomial 2: ");
    display(p2);

    result = add(p1,p2);

    printf("Result: ");
    display(result);

    return 0;
}
