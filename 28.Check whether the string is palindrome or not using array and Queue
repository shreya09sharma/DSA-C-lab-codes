#include <stdio.h>
#include <string.h>

#define MAX 100


char queue[MAX];
int front = -1, rear = -1;


void enqueue(char ch) {
    if (rear == MAX - 1) {
        printf("Queue Overflow\n");
        return;
    }
    if (front == -1)
        front = 0;

    rear++;
    queue[rear] = ch;
}


char dequeue() {
    if (front == -1 || front > rear) {
        return '\0';
    }
    return queue[front++];
}

int main() {
    char str[MAX];
    int i, len;
    int flag = 1;   

    printf("Enter a string: ");
    scanf("%s", str);

    len = strlen(str);


    for (i = 0; i < len; i++) {
        enqueue(str[i]);
    }

    
    for (i = len - 1; i >= 0; i--) {
        char ch = dequeue();

        if (ch != str[i]) {
            flag = 0;   
            break;
        }
    }

    
    if (flag == 1)
        printf("Palindrome\n");
    else
        printf("Not Palindrome\n");

    return 0;
}
