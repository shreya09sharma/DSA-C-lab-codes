#include <stdio.h>

#define SIZE 100

int s1[SIZE], s2[SIZE];
int top1 = -1, top2 = -1;

int isEmpty1() {
    return top1 == -1;
}

int isEmpty2() {
    return top2 == -1;
}

void push1(int x) {
    if (top1 == SIZE - 1) return;
    s1[++top1] = x;
}

void push2(int x) {
    if (top2 == SIZE - 1) return;
    s2[++top2] = x;
}

int pop1() {
    if (isEmpty1()) return -1;
    return s1[top1--];
}

int pop2() {
    if (isEmpty2()) return -1;
    return s2[top2--];
}

void enqueue(int x) {
    push1(x);
}

int dequeue() {
    if (isEmpty1() && isEmpty2()) return -1;

    if (isEmpty2()) {
        while (!isEmpty1()) {
            push2(pop1());
        }
    }

    return pop2();
}

int peek() {
    if (isEmpty1() && isEmpty2()) return -1;

    if (isEmpty2()) {
        while (!isEmpty1()) {
            push2(pop1());
        }
    }

    return s2[top2];
}

void display() {
    for (int i = top2; i >= 0; i--) {
        printf("%d ", s2[i]);
    }
    for (int i = 0; i <= top1; i++) {
        printf("%d ", s1[i]);
    }
    printf("\n");
}

int main() {
    enqueue(10);
    enqueue(20);
    enqueue(30);

    display();

    printf("%d\n", dequeue());
    display();

    printf("%d\n", peek());

    return 0;
}
